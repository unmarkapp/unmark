# Frontend
# Same-origin proxies (see next.config.ts rewrites) so the auth cookie is sent.
NEXT_PUBLIC_API_URL=/backend
NEXT_PUBLIC_AUTH_URL=http://localhost:8080
NEXT_PUBLIC_BILLING_URL=/billing-api

# Public Razorpay Key ID only (never expose KEY_SECRET)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Google Analytics 4 (www.unmark.ink)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-PJTRM78DME
